# ─────────────────────────────────────────────────────────────────────────────
# CampusWell — Environment Variables
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (from Supabase Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to use on the server and client.
# NEVER use the service_role key here.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
